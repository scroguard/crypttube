# Copy to .env and change the password.
POSTGRES_USER=goon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=goon

# Host directory containing your media. Mounted READ-ONLY at /media inside the
# api container; library paths configured in the admin panel are relative to /media.
MEDIA_ROOT=./media

# Host directory for generated content (thumbnails, previews, sprites).
GENERATED_ROOT=./data/generated

# Host user/group the api and worker run as: must be able to read MEDIA_ROOT and
# write GENERATED_ROOT. Use the output of `id -u` and `id -g`.
PUID=1000
PGID=1000

# Port the API is published on. Bound to localhost only by default.
API_PORT=8420

# Use polling instead of inotify for the file watcher (needed for NFS/SMB mounts,
# or libraries too large for fs.inotify.max_user_watches).
WATCHER_POLLING=false

# Set true when served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false
