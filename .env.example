# Copy to .env and change the password.
POSTGRES_USER=goon
POSTGRES_PASSWORD=change-me
POSTGRES_DB=goon

# Host directory containing your media, mounted at /media; library paths configured in
# the admin panel are relative to /media. The app never changes or moves your files. It
# deletes one only when an admin asks (Delete, duplicate removal), which needs the mount
# to be writable and PUID to have permission. MEDIA_MODE=ro forbids deletion entirely.
MEDIA_ROOT=./media
MEDIA_MODE=rw

# Host user/group the api and worker run as: must be able to read MEDIA_ROOT.
# (All data the app writes goes to Docker volumes: `pgdata` and `generated`.)
PUID=1000
PGID=1000

# Where the web UI is published. WEB_BIND=127.0.0.1 keeps it reachable from this
# machine only; use 0.0.0.0 (or a LAN address) to reach it from other hosts or from a
# reverse proxy on another machine. For a reverse proxy running in Docker on this host,
# see compose.proxy.yaml instead.
WEB_BIND=127.0.0.1
WEB_PORT=8420
# Behind a reverse proxy: its own address, so the visitor's own address is used to slow
# down password guessing (otherwise everyone looks like the proxy). A network (CIDR) only
# if nothing but the proxy is on it: anything trusted can claim any address.
TRUSTED_PROXY=127.0.0.1
# Dev only: direct API port for debugging.
API_PORT=8421

# Use polling instead of inotify for the file watcher (needed for NFS/SMB mounts,
# or libraries too large for fs.inotify.max_user_watches).
WATCHER_POLLING=false

# Limits for the background worker (scans, previews). The defaults are gentle; raise them
# on a strong server to index faster. On slow or network storage, lower the concurrency.
WORKER_CPUS=2
WORKER_MEMORY=2g
SCAN_PROBE_CONCURRENCY=4
GENERATE_CONCURRENCY=2

# Encryption of users' uploads (README: "Encrypting user uploads"). Path ON THE HOST of a
# key file made with `openssl rand -base64 32`, readable by PUID. Leave unset for no
# encryption; set it later to encrypt existing uploads. Back the key up: losing it means
# losing every encrypted upload.
# UPLOADS_KEY_FILE=/root/crypttube-uploads.key

# GPU transcoding (README: "Hardware transcoding"): add compose.vaapi.yaml (AMD/Intel)
# or compose.nvidia.yaml (NVIDIA) to COMPOSE_FILE. VAAPI also needs the host's render
# group id (getent group render), and HW_DEVICE only with several GPUs.
# COMPOSE_FILE=compose.yaml:compose.vaapi.yaml
# Live transcodes at once (more viewers get a short retry); raise it with a GPU.
# MAX_TRANSCODES=2
# RENDER_GID=
# HW_DEVICE=/dev/dri/renderD128

# Prefix of the Docker volume names (database, uploads, generated content). Only change it
# if your existing volumes carry another prefix (`docker volume ls`).
# VOLUME_PREFIX=goon-streamer

# Time zone used for the daily maintenance hour (Admin → Maintenance), e.g. America/Chicago.
TZ=UTC

# Set true when served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# Development only: uncomment to make plain `docker compose` use the dev overrides.
# COMPOSE_FILE=compose.yaml:compose.dev.yaml

# Allow setting performer/studio/tag images from a URL (the server's only outbound
# request, made only when a user asks; internal addresses are refused).
URL_IMAGE_FETCH=true
